			"isDeleted": false,
			"boundElements": [],
			"updated": 1776400360057,
			"locked": false,
			"text": "is a small program exist in \nfirst little shank of hard \ndisk do next: \n- locate operating system\nkernel\n- Loads the kernel into \ncomputer's memory\n- Start running the kernel \ncode",
			"fontSize": 17.966399843679937,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "is a small program exist in \nfirst little shank of hard \ndisk do next: \n- locate operating system\nkernel\n- Loads the kernel into \ncomputer's memory\n- Start running the kernel \ncode",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": "is a small program exist in \nfirst little shank of hard \ndisk do next: \n- locate operating system\nkernel\n- Loads the kernel into \ncomputer's memory\n- Start running the kernel \ncode",
			"link": null
		},
