			"boundElements": null,
			"updated": 1772230803117,
			"locked": false,
			"text": "The frontier is a list of walls to process in the future. When you finally pick one, you need to know:\nWhere is the wall? → the cell (r, c)\nWhich side of that cell? → the direction",
			"rawText": "The frontier is a list of walls to process in the future. When you finally pick one, you need to know:\nWhere is the wall? → the cell (r, c)\nWhich side of that cell? → the direction",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The frontier is a list of walls to process in the future. When you finally pick one, you need to know:\nWhere is the wall? → the cell (r, c)\nWhich side of that cell? → the direction",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
